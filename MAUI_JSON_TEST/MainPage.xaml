<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:MAUI_JSON_TEST.ViewModel"
             x:Class="MAUI_JSON_TEST.MainPage">
    
    <ContentPage.BindingContext>
        <viewModel:MainViewModel />
    </ContentPage.BindingContext> 
    
    <Grid RowDefinitions="Auto,*" Margin="10">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
                <Entry Placeholder="input keyword"
                       Text="{Binding SearchText}"
                       Margin="5"
                       HorizontalOptions="Fill"/>
            <Picker
                Title="Which sort"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}" />
                
             <Button Text="Search" Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsSearchEnabled}"
                        Margin="5"
                        HorizontalOptions="Fill"/>
        </VerticalStackLayout>

        
        <Grid Grid.Row = "1">
            <CollectionView 
                ItemsSource="{Binding Repositories}" 
                SelectionMode="Single" SelectionChanged="ChoseItem" >
                
                <CollectionView.EmptyView>
                    <Label Text="no data view"
                           IsVisible="{Binding IsShowNoDataMessage}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{StaticResource GitHubTextMuted}"
                           FontSize="16"/>
                </CollectionView.EmptyView>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="5"
                                BackgroundColor="{StaticResource GitHubSurface}"
                                Stroke="{StaticResource GitHubBorder}"
                                StrokeThickness="1"
                                InputTransparent="True">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Owner.Login, StringFormat='ownerName: {0}'}"
                                       TextColor="{StaticResource GitHubTextMuted}"
                                       FontSize="12" />
                                <Label Text="{Binding Name, StringFormat='name: {0}'}"
                                       TextColor="{StaticResource GitHubAccent}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding StargazersCount, StringFormat='stargazersCount: {0}'}"
                                       TextColor="{StaticResource GitHubTextMuted}"
                                       FontSize="12" />
                                <Label Text="{Binding ForksCount, StringFormat='forksCount: {0}'}"
                                       TextColor="{StaticResource GitHubTextMuted}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <ProgressBar
                Progress="{Binding LoadingProgress}"
                IsVisible="{Binding IsLoading}"
                HeightRequest="5" />
        </Grid>
        
        
    </Grid>
</ContentPage>
